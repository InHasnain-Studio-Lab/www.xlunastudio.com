{
  "name": "xlunastudio",
  "compatibility_date": "2026-09-01",
  "main": "tools/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "xlunastudio.com", "custom_domain": true },
    { "pattern": "www.xlunastudio.com", "custom_domain": true }
  ]
}
